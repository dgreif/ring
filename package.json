{
  "name": "ring",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "link-homebridge": "bash packages/homebridge-ring/link-dev-homebridge.sh",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test:watch": "pnpm --filter ring-client-api test:watch",
    "example": "pnpm --filter examples example",
    "api-example": "pnpm --filter examples api-example",
    "record-example": "pnpm --filter examples record-example",
    "return-audio-example": "pnpm --filter examples return-audio-example",
    "stream-example": "pnpm --filter examples stream-example",
    "browser-example": "pnpm --filter examples browser-example",
    "auth-cli": "pnpm --filter ring-client-api auth-cli",
    "device-data-cli": "pnpm --filter ring-client-api device-data-cli",
    "release:verify": "turbo run build test lint"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@homebridge/hap-nodejs": "^2.3.0",
    "@types/node": "26.6.6",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  }
}
