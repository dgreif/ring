{
  "name": "ring",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "link-homebridge": "bash packages/homebridge-ring/link-dev-homebridge.sh",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test:watch": "npm run test:watch -w ring-client-api",
    "example": "npm run example -w examples",
    "api-example": "npm run api-example -w examples",
    "record-example": "npm run record-example -w examples",
    "return-audio-example": "npm run return-audio-example -w examples",
    "stream-example": "npm run stream-example -w examples",
    "browser-example": "npm run browser-example -w examples",
    "auth-cli": "npm run auth-cli -w ring-client-api",
    "device-data-cli": "npm run device-data-cli -w ring-client-api",
    "release:verify": "turbo run build test lint"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.10"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@12.1.0"
}
