  "funding": [
    {
      "type": "paypal",
      "url": "https://www.paypal.me/dustingreif"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/dgreif"
    }
  ],
  "files": [
    "branding",
    "CHANGELOG.md",
    "config.schema.json",
    "lib",
    "media"
  ],
  "keywords": [
    "homebridge",
    "homebridge-plugin",
    "ring",
    "doorbell",
    "doorbot",
    "camera",
    "alarm",
    "smart",
    "light",
    "beam",
    "security",
    "category-security",
    "category-lighting",
    "category-video",
    "category-hubs",
    "category-outdoor"
